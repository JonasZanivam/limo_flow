# PostgreSQL (docker-compose)
POSTGRES_USER=limoflow
POSTGRES_PASSWORD=limoflow_dev
POSTGRES_DB=limoflow

# Backend
DATABASE_URL=postgresql://limoflow:limoflow_dev@localhost:5432/limoflow?schema=public
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
FRONTEND_URL=http://localhost:5173

# Seed (usuário admin demo)
SEED_ADMIN_EMAIL=admin@limoflow.com
SEED_ADMIN_PASSWORD=admin123
SEED_DRIVER_EMAIL=motorista@limoflow.com
SEED_DRIVER_PASSWORD=driver123

# Observabilidade
LOG_LEVEL=info
LOG_TO_FILE=true
OTEL_ENABLED=true
OTEL_SERVICE_NAME=limoflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# VITE_API_URL: omita em dev (usa proxy /api do Vite). Em produção, use a URL da API.

# Fase 2
# GOOGLE_MAPS_API_KEY=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
