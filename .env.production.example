# Copie para .env na VPS: cp .env.production.example .env
# Gere secrets fortes: openssl rand -base64 48

# Domínio público (sem barra final)
FRONTEND_URL=https://seudominio.com.br

# PostgreSQL
POSTGRES_USER=limoflow
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=limoflow

# JWT (mínimo 32 caracteres aleatórios cada)
JWT_SECRET=troque-por-string-aleatoria-com-pelo-menos-32-chars
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-com-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Porta HTTP exposta no host (80 ou 8080 se já houver proxy)
HTTP_PORT=80

# Seed apenas no primeiro deploy (depois mude para false)
RUN_SEED=true

# Credenciais demo do seed (altere após o primeiro login)
SEED_ADMIN_EMAIL=admin@limoflow.com
SEED_ADMIN_PASSWORD=troque-senha-admin
SEED_DRIVER_EMAIL=motorista@limoflow.com
SEED_DRIVER_PASSWORD=troque-senha-motorista

# Backend (DATABASE_URL é montada automaticamente no docker-compose.prod.yml)
PORT=3000
COOKIE_PATH_PREFIX=/api
LOG_LEVEL=info
